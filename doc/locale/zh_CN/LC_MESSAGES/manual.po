#: manual/windows.md:1
msgid "Windows"
msgstr "窗口"

#: manual/index.md:13
#: manual/windows.md:5
msgid "Separate canvas per window"
msgstr "每个窗口独立画布"

#: manual/index.md:13
#: manual/index.md:14
#: manual/index.md:15
#: manual/index.md:16
#: manual/index.md:17
#: manual/index.md:18
#: manual/index.md:19
